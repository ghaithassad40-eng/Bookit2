# Supabase
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: enable edge function for atomic booking
VITE_USE_EDGE_BOOKING=false

# Optional: route payments through the charge-payment Edge Function instead of
# the in-browser mock adapter. Falls back to mock if the call fails so the UX
# never breaks during development.
VITE_USE_EDGE_PAYMENTS=false

# Optional: route the booking concierge through the ai-concierge Edge Function
VITE_USE_AI_CONCIERGE=false

# Optional: Google Maps API key. Leave blank and the embedded map will fall
# back to the public Google Maps URL (works without a key, but no place
# details overlay). With a key, the LocationCard uses the Embed API for
# richer integration (zoom controls, satellite, traffic).
# Restrict the key to your domain in the Google Cloud Console.
VITE_GOOGLE_MAPS_KEY=

# ─── MyFatoorah ──────────────────────────────────────────────────────────────
# Enable the MyFatoorah hosted payment flow on the frontend. When false the
# UI uses an in-app simulated MyFatoorah page (no real money).
VITE_MYFATOORAH_ENABLED=false

# Set the Edge Function secrets below from the Supabase CLI:
#   supabase secrets set MYFATOORAH_API_KEY="<your test or live token>"
#   supabase secrets set MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
#   supabase secrets set MYFATOORAH_RETURN_BASE=https://your-public-site.com
#
# Test (staging) endpoint:
#   https://apitest.myfatoorah.com
# Production endpoints (per region):
#   KW  https://api.myfatoorah.com
#   SA  https://api-sa.myfatoorah.com
#   AE  https://api-ae.myfatoorah.com
#   EG  https://api-eg.myfatoorah.com
#   QA  https://api-qa.myfatoorah.com
#   BH  https://api-bh.myfatoorah.com
#   OM  https://api-om.myfatoorah.com
#   JO  https://api-jo.myfatoorah.com
#
# Public test API token published in MyFatoorah's documentation
# (use only against apitest.myfatoorah.com — rotate to a real key for live):
# rLtt6JWvbUHDDhsZnfpAhpYk4dxYDQkbcPTyGaKp2TYqQgG7FGZ5Th_WD53Oq8Ebz6A53njUoo1w3pjU1D4vs_ZMqFiz_j0urb_BH9Oq9VZoKFoJEDAbRZepGcQanImyYrry7Kt6MnMdgfG5jn4HngWoRdKduNNyP4kzcgtwsV_uwHFIFbJ4
